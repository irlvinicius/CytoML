{
  "image_size": 224,
  "backbone": "resnet50",
  "epochs": 100,
  "batch_size": 32,
  "lr": 0.001,
  "optimizer": "adam",
  "weight_decay": 0.0,
  "scheduler": "plateau",
  "plateau_factor": 0.02,
  "plateau_patience": 3,
  "plateau_min_lr": 1e-06,
  "freeze": "paper",
  "class_weights": false,
  "label_smoothing": 0.0,
  "monitor": "val_loss",
  "early_stopping_patience": 15,
  "resize": "stretch",
  "augment": "paper",
  "seed": 0
}